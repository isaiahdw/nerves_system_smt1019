+        irq_enable = <0>;
+        als_threshold_high = <100>;
+        als_threshold_low = <10>;
+        als_ctrl_gain = <2>; /* 0:x1 1:x4 2:x16 3:x64 */
+        poll_delay_ms = <100>;
+    };
+
+	gc5035: gc5035@37 {
