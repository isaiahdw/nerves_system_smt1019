dts: enable the GC5035 camera pipeline.

The mainboard has a CAMERA FPC (FCC internal photos) and the ODM's own
board dts ships gc5035 enabled via rk3576-r157-cam.dtsi, with
board-level camera power (vcc_mipidcphy0 gpio3-C6, camera_pwdn
gpio3-C7) always-on. Bring the pipeline back, trimmed to gc5035 only:
the vendor dtsi's other sensors are EVB options and its ls_stk3x1x
kernel node would claim the ALS at i2c4-0x48 out from under the app's
userspace driver. Replaces the dropped 0010 patch: csi2_dphy0/1_hw
must be enabled again because csi2_dcphy0 references both via
rockchip,hw.

--- a/arch/arm64/boot/dts/rockchip/rk3576s-r157-v2.0-wf1019-linux.dts	2026-07-25 19:39:50
+++ b/arch/arm64/boot/dts/rockchip/rk3576s-r157-v2.0-wf1019-linux.dts	2026-07-25 19:39:50
@@ -903,4 +903,164 @@
  * probe only produced errors. (The NPU stays enabled: planned product use.) */
 &pwm0_2ch_0 {
 	status = "disabled";
+};
+
+/* Camera: GalaxyCore GC5035 (5 MP, 2-lane MIPI CSI-2) on the mainboard
+ * "CAMERA" FPC. Trimmed from the vendor rk3576-r157-cam.dtsi: gc5035 only
+ * (the other sensors there are EVB options, and its ls_stk3x1x node would
+ * fight the app's userspace ALS driver on i2c4). Power is the board's
+ * always-on vcc_mipidcphy0 (gpio3 C6) + camera_pwdn (gpio3 C7) regulators
+ * declared above. Pipeline: gc5035 -> csi2_dcphy0 -> mipi0_csi2 -> rkcif
+ * -> rkisp_vir0 (-> rkvpss). */
+
+&i2c4 {
+	gc5035: gc5035@37 {
+		compatible = "galaxycore,gc5035";
+		status = "okay";
+		reg = <0x37>;
+		clocks = <&cru CLK_MIPI_CAMERAOUT_M0>;
+		clock-names = "xvclk";
+		power-domains = <&power RK3576_PD_VI>;
+		avdd-supply = <&vcc_mipidcphy0>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&cam_clk0m0_clk0>;
+		reset-gpios = <&gpio3 RK_PD5 GPIO_ACTIVE_HIGH>;
+		rockchip,camera-module-index = <1>;
+		rockchip,camera-module-facing = "front";
+		rockchip,camera-module-name = "default";
+		rockchip,camera-module-lens-name = "default";
+		port {
+			gc5035_out: endpoint {
+				remote-endpoint = <&mipi_in_ucam6>;
+				data-lanes = <1 2>;
+			};
+		};
+	};
+};
+
+&csi2_dcphy0 {
+	status = "okay";
+
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+		port@0 {
+			reg = <0>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			mipi_in_ucam6: endpoint@7 {
+				reg = <7>;
+				remote-endpoint = <&gc5035_out>;
+				data-lanes = <1 2>;
+			};
+		};
+		port@1 {
+			reg = <1>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			csidcphy0_out: endpoint@0 {
+				reg = <0>;
+				remote-endpoint = <&mipi0_csi2_input>;
+			};
+		};
+	};
+};
+
+&mipi0_csi2 {
+	status = "okay";
+
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		port@0 {
+			reg = <0>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			mipi0_csi2_input: endpoint@1 {
+				reg = <1>;
+				remote-endpoint = <&csidcphy0_out>;
+			};
+		};
+
+		port@1 {
+			reg = <1>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			mipi0_csi2_output: endpoint@0 {
+				reg = <0>;
+				remote-endpoint = <&cif_mipi_in0>;
+			};
+		};
+	};
 };
+
+&rkcif {
+	status = "okay";
+};
+
+&rkcif_mipi_lvds {
+	status = "okay";
+
+	port {
+		cif_mipi_in0: endpoint {
+			remote-endpoint = <&mipi0_csi2_output>;
+		};
+	};
+};
+
+&rkcif_mipi_lvds_sditf {
+	status = "okay";
+
+	port {
+		mipi_lvds_sditf: endpoint {
+			remote-endpoint = <&isp_vir0>;
+		};
+	};
+};
+
+&rkcif_mmu {
+	status = "okay";
+};
+
+&rkisp {
+	status = "okay";
+};
+
+&rkisp_mmu {
+	status = "okay";
+};
+
+&rkisp_vir0 {
+	status = "okay";
+
+	port {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		isp_vir0: endpoint@0 {
+			reg = <0>;
+			remote-endpoint = <&mipi_lvds_sditf>;
+		};
+	};
+};
+
+&rkisp_vir0_sditf {
+	status = "okay";
+};
+
+&rkvpss {
+	status = "okay";
+};
+
+&rkvpss_mmu {
+	status = "okay";
+};
+
+&rkvpss_vir0 {
+	status = "okay";
+};
