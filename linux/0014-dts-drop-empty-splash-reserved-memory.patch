dts: drop the empty drm-logo/cubic-lut splash reserved-memory nodes.

rk3576-linux.dtsi declares zero-size drm-logo/drm-cubic-lut
reserved-memory placeholders for a U-Boot boot-splash framebuffer
handover. Our U-Boot never fills them (it displays the resource
partition logo itself and the panel keeps scanning it until a DRM
client takes over), so the kernel just logs two reserved-memory
errors every boot. Remove the nodes and the display_subsystem
references, and demote the drm driver's "failed to parse loader
memory" message to debug — no logo handover is the normal case here.

--- a/arch/arm64/boot/dts/rockchip/rk3576-linux.dtsi	2026-07-26 11:34:15
+++ b/arch/arm64/boot/dts/rockchip/rk3576-linux.dtsi	2026-07-26 11:34:15
@@ -40,16 +40,6 @@
 		#size-cells = <2>;
 		ranges;
 
-		drm_logo: drm-logo@0 {
-			compatible = "rockchip,drm-logo";
-			reg = <0x0 0x0 0x0 0x0>;
-		};
-
-		drm_cubic_lut: drm-cubic-lut@0 {
-			compatible = "rockchip,drm-cubic-lut";
-			reg = <0x0 0x0 0x0 0x0>;
-		};
-
 		ramoops: ramoops@40110000 {
 			compatible = "ramoops";
 			/* 0x40110000 to 0x401f0000 is for ramoops */
@@ -69,8 +59,6 @@
 };
 
 &display_subsystem {
-	memory-region = <&drm_logo>, <&drm_cubic_lut>;
-	memory-region-names = "drm-logo", "drm-cubic-lut";
 	/* devfreq = <&dmc>; */
 };
 
--- a/drivers/gpu/drm/rockchip/rockchip_drm_logo.c	2026-07-26 13:21:39
+++ b/drivers/gpu/drm/rockchip/rockchip_drm_logo.c	2026-07-26 13:21:39
@@ -1058,7 +1058,7 @@
 	}
 
 	if (init_loader_memory(drm_dev)) {
-		dev_warn(drm_dev->dev, "failed to parse loader memory\n");
+		dev_dbg(drm_dev->dev, "failed to parse loader memory\n");
 		return;
 	}
 
