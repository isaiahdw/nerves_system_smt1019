# Nerves additions on top of rockchip_linux_defconfig + rk3576.config
#
# rockchip_linux_defconfig already enables SQUASHFS(+XZ), VFAT, NLS_CODEPAGE_437,
# NLS_ISO8859_1, WATCHDOG, and DW_WATCHDOG (verified against the 20251118 SDK).

# The armbian tree's rockchip_linux_defconfig lacks the tablet-maker's edits
# that the SDK's copy carried. Restore the ones this board actually uses
# (found by config-parity diff against the last SDK-tarball build):
# Mainline Goodix driver for the GT9271 touch controller (DT node in patch
# 0012). The tree's Rockchip gt9xx driver stays off.
CONFIG_TOUCHSCREEN_GOODIX=y
# CONFIG_TOUCHSCREEN_GT9XX is not set

# ES7202 PDM ADC feeding the mic array (i2c3@0x32). Without this driver the
# chip stays in standby and the PDM capture card records silence. The DT
# compatible is "ES7202_PDM_ADC_2", which the driver only compiles in when
# MIC_MAX_CHANNELS > 2.
CONFIG_SND_SOC_ES7202=y
CONFIG_SND_SOC_ES7202_MIC_MAX_CHANNELS=4

# TUN/TAP built in: standard Nerves expectation (VPNs, overlay networks).
# No uevent ever fires for /dev/net/tun, so modalias autoload can't load it
# as a module on first open by some userspaces — built-in sidesteps that.
CONFIG_TUN=y
# ... and small parity restores: BT bits.
CONFIG_BT_HS=y
CONFIG_BT_RFCOMM_TTY=y
# NOT restored: DMABUF_HEAPS_ROCKCHIP -- this tree's heap driver lacks
# rk_dma_heap_cma_setup, so enabling it breaks the vmlinux link (the SDK's
# newer heap code differs). Nothing in our stack uses the rk heap (DRM GEM
# allocates display buffers; Mali kbase has its own allocator).
# MGLRU: multi-gen LRU page reclaim (in 6.1 but default-off in this tree).
# Better reclaim decisions under memory pressure; no known downside here.
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y

# Reboot 10s after a kernel panic (belt-and-suspenders alongside the
# heart-armed watchdog, which would also fire eventually).
CONFIG_PANIC_TIMEOUT=10

# An always-on wall panel must never sleep: remove the suspend capability
# entirely rather than trusting nothing ever writes /sys/power/state.
# CONFIG_SUSPEND is not set

# Plug-and-play peripheral support expected of Nerves systems (audited
# against nerves_system_rpi5). All modules: zero cost until the hardware
# is plugged in. CH341 = the ubiquitous cheap USB-UART; usbnet/cdc_ether/
# rndis = USB ethernet dongles and phone tethering; qmi_wwan (+ the
# USB_SERIAL_OPTION driver above it) = USB cellular modems; exfat = the
# out-of-box format of large USB sticks. DT-gated drivers (w1, i2c-gpio,
# at24, pwm-fan, uio) deliberately omitted: dead weight without DT nodes.
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_USBNET=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USB_NET_QMI_WWAN=m
CONFIG_EXFAT_FS=m

# Second, module-by-module pass of the rpi5 audit:
# - squashfs rootfs read perf: direct page-cache reads + per-CPU parallel
#   decompression (8 cores; replaces FILE_CACHE + DECOMP_SINGLE)
CONFIG_SQUASHFS_FILE_DIRECT=y
CONFIG_SQUASHFS_DECOMP_MULTI_PERCPU=y
# - pstore pmsg: /dev/pmsg0 lets the app write breadcrumbs that survive a
#   crash/reboot (ramoops console+dmesg capture is already enabled)
CONFIG_PSTORE_PMSG=y
# - ALSA loopback: capture the LADSPA-processed output for audio tuning
CONFIG_SND_ALOOP=m
# - FAT short-name codepage for western-European USB sticks
CONFIG_NLS_CODEPAGE_850=y
# NOT pre-staged: BT_HCIUART_BCM/3WIRE (Kconfig drops them without
# BT_HCIUART_SERDEV + SERIAL_DEV_BUS; the serdev-vs-ldisc decision belongs
# to the BT bring-up task).
# - LED triggers for the light ring: kernel-side timer/pattern/heartbeat
#   effects via /sys/class/leds/*/trigger, no userspace CPU
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_TIMER=y
CONFIG_LEDS_TRIGGER_PATTERN=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y

# Vendor storage: the MMC backend is the real one (eMMC-backed, holds the
# persistent MACs). The MTD variant has no MTD device on this board and
# only produced an eternal "deferred probe pending" at boot.
# CONFIG_ROCKCHIP_MTD_VENDOR_STORAGE is not set

# Deliberately NOT restored from the SDK defconfig: TOUCHSCREEN_HYN (other
# vendor's touch), STMVL53L0X (ToF, camera-adjacent, unused), RTC_DRV_ROCKCHIP
# (board RTC is the i2c HYM8563, which stays enabled), rv1126b/ISP/VPSS/MPP
# symbols (don't exist in this tree / camera stack unused).

# The application data partition is f2fs
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_SECURITY=y

# GPU: the vendor Mali Bifrost kmod (CONFIG_MALI_BIFROST=y from rk3576.config)
# provides /dev/mali0 for the proprietary libmali userspace (EGL/GLES/GBM).
# The open Panfrost path was evaluated but Mesa 25's panfrost requires an LLVM
# build that OOMs the current build env; revisit later (needs Docker >12GB).

# vintage_net's RouteManager uses policy routing (per-interface route tables
# + rules). Without these, `ip route add ... table N` fails with
# "RTNETLINK answers: Operation not supported", crashing vintage_net's
# interface subtree seconds after every successful DHCP lease — which
# presented as WiFi disconnecting every ~21s during bring-up.
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y

# Generic Nerves niceties present in official systems (cf. nerves_system_bbb)
# but missing from the Android-heritage vendor defconfig.
# (TUN is built in above — do not re-add =m here: within one fragment the
# LAST occurrence wins the merge.)
CONFIG_POSIX_MQUEUE=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_OF_OVERLAY=y
CONFIG_FW_LOADER_USER_HELPER=y
# Watchdog must not be disarmable once Erlang heart opens it
CONFIG_WATCHDOG_NOWAYOUT=y
# USB gadget ethernet (g_ether) — enables usb0 gadget networking if/when the
# USB-C port's controller runs in peripheral/OTG mode
CONFIG_USB_ETH=y

# The WiFi module on this unit is a Broadcom AP6281S (BCM43013, SDIO ID
# 02D0:4381) despite the SDK board config and dts saying "aic8800" — the
# tablet maker ships mixed radio variants and detects at runtime. AP6XXX
# builds bcmdhd.ko + dhd_static_buf.ko (same as the vendor kernel).
# WL_ROCKCHIP=m (defconfig has =y) plus explicit CFG80211/MAC80211=m:
# built-in cfg80211 requests regulatory.db before the rootfs is mounted
# and logs "failed to load regulatory.db" every boot; as a module it
# loads with bcmdhd (via load-wifi-modules) after the rootfs is up and
# the wireless-regdb file is found. The explicit =m lines are required —
# expanding the defconfig records CFG80211/MAC80211 as explicit =y (from
# the old WL_ROCKCHIP=y select), and the fragment merge keeps explicit
# values unless overridden. (mac80211 is unused — bcmdhd is a full-MAC
# driver — but the vendor Kconfig selects it, so >=m is forced.)
CONFIG_WL_ROCKCHIP=m
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_AP6XXX=m

# Virtual terminal, but NO framebuffer console on the MIPI panel: everything
# here (kmscube, and any DRM/KMS UI stack) drives DRM/KMS directly and
# nothing uses legacy fbdev. We give up the on-panel kernel/fbcon console;
# SSH + usb0 cover debugging, and the panel belongs to the application UI.
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_VT_HW_CONSOLE_BINDING=y
# CONFIG_DRM_FBDEV_EMULATION is not set
# CONFIG_FB is not set
# CONFIG_FRAMEBUFFER_CONSOLE is not set

# Light ring: an RGB LED driven by 3 PWM channels (red/green/blue). We use the
# mainline leds-pwm driver rather than the vendor out-of-tree "pwm-four-leds"
# driver (drivers/leds/wa-two-leds.c, /dev/ledjni): the vendor driver caps each
# channel at 16 brightness levels, forcing userspace temporal dithering, whereas
# leds-pwm exposes native PWM-resolution brightness (0-255) at
# /sys/class/leds/{red,green,blue}. The channel enables + `pwm-leds` DT node are
# added by linux/0005-dts-rk3576-wf1019-rgb-light-ring-pwm-leds.patch.
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_PWM=y

# Camera: the SMT1019's 5 MP GalaxyCore GC5035 (MIPI CSI-2 into rkcif/rkisp,
# see dts patch 0017). The whole stack is built as modules and loaded by
# /usr/bin/load-camera-modules only after the sensor driver binds: some
# units ship without the camera, and the vendor rkcif/rkisp drivers
# register their ~25 video/media nodes even with no sensor (and rkisp
# oopses in v4l2-async cleanup if unbound in that state), so the clean
# way to "disable" the camera on those units is to never load the
# pipeline. The base defconfig has these =y; the explicit =m here
# overrides it (the merge keeps explicit fragment values, same as the
# WiFi stack above). mipi-csi2 and the sditf/hw devices live inside the
# rkcif/rkisp modules.
CONFIG_VIDEO_GC5035=m
CONFIG_VIDEO_ROCKCHIP_CIF=m
CONFIG_VIDEO_ROCKCHIP_ISP=m
CONFIG_PHY_ROCKCHIP_CSI2_DPHY=m
# ispp/vpss are =y in the base defconfig and ispp links against rkisp
# symbols (vmlinux link fails if they stay built-in with isp as a
# module). Neither is part of this board's pipeline (rkcif -> isp39
# mainpath), so they become modules that are simply never loaded.
CONFIG_VIDEO_ROCKCHIP_ISPP=m
CONFIG_VIDEO_ROCKCHIP_VPSS=m

# CMA 16->64 MB: the rkisp bayertnr (temporal NR) IIR buffers are ~10 MB
# physically-contiguous each and their init ioctl failed at 16 MB, which
# forced bayertnr off in the camera IQ (package/rkaiq/README.md).
CONFIG_CMA_SIZE_MBYTES=64
