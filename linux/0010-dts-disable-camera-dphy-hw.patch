dts: disable the unused camera D-PHY hardware blocks.

csi2-dphy0-hw/csi2-dphy1-hw are enabled by default in rk3576.dtsi; with
the camera pipeline removed (patch 0008) they only probe to idle.

diff -urN a/arch/arm64/boot/dts/rockchip/rk3576s-r157-v2.0-wf1019-linux.dts b/arch/arm64/boot/dts/rockchip/rk3576s-r157-v2.0-wf1019-linux.dts
--- a/arch/arm64/boot/dts/rockchip/rk3576s-r157-v2.0-wf1019-linux.dts	2026-07-22 10:06:32
+++ b/arch/arm64/boot/dts/rockchip/rk3576s-r157-v2.0-wf1019-linux.dts	2026-07-22 10:06:32
@@ -903,3 +903,13 @@
 &pwm0_2ch_0 {
 	status = "disabled";
 };
+
+/* Camera D-PHY hardware blocks: enabled by default in the SoC dtsi but
+ * unused with the camera pipeline removed. Re-enable with the camera. */
+&csi2_dphy0_hw {
+	status = "disabled";
+};
+
+&csi2_dphy1_hw {
+	status = "disabled";
+};
