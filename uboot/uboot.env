# Nerves U-Boot environment for the SMT1019 (RK3576S)
#
# Compiled into uboot-env.bin and written raw at 15 MB (0xF00000) — see
# fwup_include/fwup-common.conf and rootfs_overlay/etc/fw_env.config.
#
# The committed env-reading U-Boot (CONFIG_ENV_IS_IN_MMC, ENV_OFFSET=0xF00000)
# loads this environment and runs `bootcmd` below, which implements A/B slot
# selection with automatic revert of unvalidated firmware. CONFIG_BOOTCOMMAND
# is left at the vendor default, so a missing/corrupt environment falls back
# to the extlinux manual-recovery boot path instead of bricking.
#
# NOTE: loading a saved environment replaces U-Boot's built-in defaults, so
# the memory-layout variables from include/configs/rk3576_common.h are
# reproduced here.

# A/B boot with automatic revert. If the saved env is ever corrupted, U-Boot
# ignores it and its compiled-in default environment (distro_bootcmd) boots
# the extlinux/extlinux.conf still on the FAT partition — automatic recovery
# without an explicit fallback here.
bootcmd=run nerves_init nerves_boot

# From evb_rk3576.h ROCKCHIP_DEVICE_SETTINGS. LOAD-BEARING for the boot
# splash: with CONFIG_SYS_CONSOLE_IS_IN_ENV, the video/display driver is
# probed ONLY via `stdout` naming vidconsole (console_init_r ->
# stdio_get_by_name("vidconsole") -> rockchip_display_probe). Without
# these, rockchip_show_logo() has an empty display list and silently
# shows nothing.
stdin=serial
stdout=serial,vidconsole
stderr=serial,vidconsole

# From rk3576_common.h ENV_MEM_LAYOUT_SETTINGS
scriptaddr=0x40500000
pxefile_addr_r=0x40600000
fdt_addr_r=0x48300000
kernel_addr_r=0x40400000
kernel_addr_c=0x45480000
ramdisk_addr_r=0x4a200000

#
# Nerves variables
#

nerves_fw_active=a

# Validation is performed by nerves_runtime's startup guard once all OTP
# applications start (autovalidate=0). If a newly-installed firmware fails
# to reach that point before the next boot, nerves_init reverts to the
# previous slot.
nerves_fw_autovalidate=0

# Set to 1 at factory-flash time (fwup complete) since that firmware is
# implicitly trusted.
nerves_fw_validated=1

# 0 on the first boot after an install; U-Boot sets it to 1 so a second
# boot without validation triggers the revert.
nerves_fw_booted=0

nerves_revert=\
    if test ${nerves_fw_active} = "a"; then\
        echo "Reverting to firmware slot B";\
        setenv nerves_fw_active "b";\
    else\
        echo "Reverting to firmware slot A";\
        setenv nerves_fw_active "a";\
    fi

# Keep the U-Boot bootcount-scheme variables (upgrade_available, bootcount)
# out of the saved environment. nerves_runtime checks that scheme BEFORE
# nerves_fw_validated (firmware_validation_status/0), so a persisted
# upgrade_available=0 makes every upgraded boot read as already validated —
# the startup guard then never writes nerves_fw_validated=1 and the next
# unattended reboot reverts. Historically the ops.fw validate task set
# upgrade_available=0 on the first validation; the vendor U-Boot also
# persists assorted runtime vars via saveenv. Deleting the pair here before
# any saveenv keeps the disk env clean no matter who sets them.
nerves_init=\
    env delete upgrade_available bootcount;\
    if test ${nerves_fw_booted} = 1; then\
        if test ${nerves_fw_validated} = 0; then\
            run nerves_revert;\
            setenv nerves_fw_validated 1;\
            saveenv;\
        fi;\
    else\
        setenv nerves_fw_booted 1;\
        if test ${nerves_fw_autovalidate} = 1; then\
            setenv nerves_fw_validated 1;\
        fi;\
        saveenv;\
    fi;\
    setenv bootfile Image.${nerves_fw_active};\
    setenv fdtfile rk3576-smt1019.${nerves_fw_active}.dtb;\
    if test ${nerves_fw_active} = "a"; then\
        setenv uenv_root /dev/mmcblk0p2;\
    else\
        setenv uenv_root /dev/mmcblk0p3;\
    fi

console=ttyFIQ0
cmdline=
# fdtfile is set per-slot by nerves_init (rk3576-smt1019.<slot>.dtb) so a
# reverted upgrade never runs the old kernel against the new device tree.

nerves_setargs=setenv bootargs console=${console} console=tty1 root=${uenv_root} rootfstype=squashfs rootwait ${cmdline}

nerves_boot=\
    load mmc 0:1 ${kernel_addr_r} ${bootfile};\
    load mmc 0:1 ${fdt_addr_r} ${fdtfile};\
    run nerves_setargs;\
    booti ${kernel_addr_r} - ${fdt_addr_r}
