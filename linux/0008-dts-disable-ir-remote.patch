dts: disable the unused IR-remote receiver.

The EVB input-keymap dtsi (included via rk3576s-evb-r157.dtsi) enables an
IR remote decoder on pwm0_2ch_0 -- the tablet has no IR receiver, and the
probe only produced "IRQ index 1 not found" errors. The NPU is left
enabled for planned product use.

diff -urN a/arch/arm64/boot/dts/rockchip/rk3576s-r157-v2.0-wf1019-linux.dts b/arch/arm64/boot/dts/rockchip/rk3576s-r157-v2.0-wf1019-linux.dts
--- a/arch/arm64/boot/dts/rockchip/rk3576s-r157-v2.0-wf1019-linux.dts	2026-07-22 09:23:02
+++ b/arch/arm64/boot/dts/rockchip/rk3576s-r157-v2.0-wf1019-linux.dts	2026-07-22 09:23:02
@@ -896,3 +896,10 @@
 	pinctrl-0 = <&i2c4m3_xfer>;
 	clock-frequency = <400000>;
 };
+
+/* The EVB input-keymap dtsi (pulled in by rk3576s-evb-r157.dtsi) enables an
+ * IR remote decoder on pwm0_2ch_0; the tablet has no IR receiver and the
+ * probe only produced errors. (The NPU stays enabled: planned product use.) */
+&pwm0_2ch_0 {
+	status = "disabled";
+};
